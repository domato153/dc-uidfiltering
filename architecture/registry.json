{
  "schemaVersion": 1,
  "registryVersion": 6,
  "authorities": [
    {
      "id": "behavior-baselines",
      "path": "verification/baselines.json",
      "owns": "control lineage and exact baseline artifact digests"
    },
    {
      "id": "build-topology",
      "path": "build/targets.json",
      "owns": "target versions, output names, ordered source inputs, and input roles"
    },
    {
      "id": "current-work-state",
      "path": "docs/work/CURRENT_STATE.md",
      "owns": "accepted phase, exact result SHA, stale evidence, and next bounded task"
    },
    {
      "id": "semantic-architecture",
      "path": "architecture/registry.json",
      "owns": "accepted components, layers, contracts, relations, and invariants"
    },
    {
      "id": "ui-host-contracts",
      "path": "docs/ui-surface-contracts.md",
      "owns": "compact live DOM, geometry, event, and visual-owner contracts"
    },
    {
      "id": "verification-routing",
      "path": "verification/gates.json",
      "owns": "impact profiles, deterministic gates, and failure classes"
    }
  ],
  "contracts": [
    {
      "id": "artifact-lineage",
      "summary": "Every tested or published userscript is bound to an exact source SHA and SHA-256."
    },
    {
      "id": "filter-semantics",
      "summary": "Mobile and PC preserve filtering decisions, personal blocks, identity parsing, and delayed-content coverage."
    },
    {
      "id": "host-dom-events",
      "summary": "Site-owned nodes, forms, native handlers, popup descendants, order, and submission paths remain intact."
    },
    {
      "id": "initialization-lifecycle",
      "summary": "Document-start locking, overlay release, duplicate guard, pageshow recovery, and teardown form one lifecycle."
    },
    {
      "id": "metadata-scope",
      "summary": "Board-route matches, grants, noframes, and document-start timing remain unchanged unless explicitly approved."
    },
    {
      "id": "proof-integrity",
      "summary": "Evidence binds SUT, oracle, fixture, harness, toolchain, route, and complete result status."
    },
    {
      "id": "storage-compatibility",
      "summary": "GM keys, readable legacy shapes, defaults, and round trips remain compatible."
    },
    {
      "id": "target-isolation",
      "summary": "PC receives shared filter and management UI without mobile host layout or theme CSS."
    },
    {
      "id": "ui-ownership",
      "summary": "Each surface has one final visual owner; presentation consumes snapshots and emits intents only."
    }
  ],
